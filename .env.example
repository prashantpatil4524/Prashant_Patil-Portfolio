# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Connectivity (Atlas Connection String)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Secure Admin Authentication (JSON Web Token config)
JWT_SECRET=yoursecretphrase_min_32_characters_long_for_high_entropy

# Standard Admin Core Login credentials
ADMIN_EMAIL=prashantpatil4524@gmail.com
ADMIN_PASSWORD=your_secure_hashable_password

